{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvst.org/schema/module-ui.schema.json",
  "title": "OpenVST module UI document, version 0",
  "description": "Declarative, data-only UI description rendered natively by the OpenVST container. No script, no markup, no remote resource, no styling key. This schema constrains the shape of one document; the constraints that JSON Schema cannot express (total node count, tree depth, parameter bindings, toggle ranges) are enforced by openvst/package_validation.py and listed in $comment on the affected definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "layout"],
  "properties": {
    "schema": {
      "const": "openvst.ui/0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "$comment": "Optional display title. Printable ASCII only; the validator refuses non-ASCII text."
    },
    "layout": {
      "$ref": "#/$defs/node"
    }
  },
  "$defs": {
    "node": {
      "description": "One component node. The type key selects the allowed key set; an unknown key is rejected, never ignored.",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["column", "row", "group", "knob", "slider", "toggle", "value", "label", "spacer"]
        },
        "gap": {
          "$ref": "#/$defs/gap"
        },
        "padding": {
          "$ref": "#/$defs/padding"
        },
        "width": {
          "$ref": "#/$defs/extent"
        },
        "height": {
          "$ref": "#/$defs/extent"
        },
        "visible": {
          "type": "boolean",
          "default": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"type": {"const": "column"}},
            "required": ["type"]
          },
          "then": {"$ref": "#/$defs/container"}
        },
        {
          "if": {
            "properties": {"type": {"const": "row"}},
            "required": ["type"]
          },
          "then": {"$ref": "#/$defs/container"}
        },
        {
          "if": {
            "properties": {"type": {"const": "group"}},
            "required": ["type"]
          },
          "then": {"$ref": "#/$defs/group"}
        },
        {
          "if": {
            "properties": {"type": {"const": "knob"}},
            "required": ["type"]
          },
          "then": {"$ref": "#/$defs/knob"}
        },
        {
          "if": {
            "properties": {"type": {"const": "slider"}},
            "required": ["type"]
          },
          "then": {"$ref": "#/$defs/slider"}
        },
        {
          "if": {
            "properties": {"type": {"const": "toggle"}},
            "required": ["type"]
          },
          "then": {"$ref": "#/$defs/toggle"}
        },
        {
          "if": {
            "properties": {"type": {"const": "value"}},
            "required": ["type"]
          },
          "then": {"$ref": "#/$defs/value"}
        },
        {
          "if": {
            "properties": {"type": {"const": "label"}},
            "required": ["type"]
          },
          "then": {"$ref": "#/$defs/label"}
        },
        {
          "if": {
            "properties": {"type": {"const": "spacer"}},
            "required": ["type"]
          },
          "then": {"$ref": "#/$defs/spacer"}
        }
      ]
    },

    "gap": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "padding": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "extent": {
      "description": "A fixed pixel size, or a layout hint.",
      "oneOf": [
        {"enum": ["auto", "fill"]},
        {"type": "integer", "minimum": 24, "maximum": 400}
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "$comment": "Printable ASCII only; the validator refuses non-ASCII text."
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "$comment": "Printable ASCII only; overrides the unit declared by the manifest parameter."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "$comment": "Printable ASCII only."
    },
    "param": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "$comment": "Must be a parameter id declared in the package manifest parameters array. The validator rejects an unknown id and rejects a third binding of the same id."
    },

    "container": {
      "type": "object",
      "required": ["type", "children"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["column", "row"]},
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/node"},
          "$comment": "At least one child: an empty column or row has no size and no purpose. The whole document is limited to 128 nodes and a depth of 8; the validator enforces both."
        },
        "gap": {"$ref": "#/$defs/gap"},
        "padding": {"$ref": "#/$defs/padding"},
        "width": {"$ref": "#/$defs/extent"},
        "height": {"$ref": "#/$defs/extent"},
        "visible": {"type": "boolean"}
      }
    },

    "group": {
      "type": "object",
      "required": ["type", "title", "children"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "group"},
        "title": {"$ref": "#/$defs/title"},
        "children": {
          "type": "array",
          "items": {"$ref": "#/$defs/node"}
        },
        "gap": {"$ref": "#/$defs/gap"},
        "padding": {"$ref": "#/$defs/padding"},
        "width": {"$ref": "#/$defs/extent"},
        "height": {"$ref": "#/$defs/extent"},
        "visible": {"type": "boolean"}
      }
    },

    "knob": {
      "type": "object",
      "required": ["type", "param"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "knob"},
        "param": {"$ref": "#/$defs/param"},
        "label": {"$ref": "#/$defs/text"},
        "size": {"enum": ["small", "medium", "large"]},
        "unit": {"$ref": "#/$defs/unit"},
        "width": {"$ref": "#/$defs/extent"},
        "height": {"$ref": "#/$defs/extent"},
        "visible": {"type": "boolean"}
      }
    },

    "slider": {
      "type": "object",
      "required": ["type", "param"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "slider"},
        "param": {"$ref": "#/$defs/param"},
        "label": {"$ref": "#/$defs/text"},
        "size": {"enum": ["small", "medium", "large"]},
        "unit": {"$ref": "#/$defs/unit"},
        "width": {"$ref": "#/$defs/extent"},
        "height": {"$ref": "#/$defs/extent"},
        "visible": {"type": "boolean"}
      }
    },

    "toggle": {
      "type": "object",
      "required": ["type", "param"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "toggle"},
        "param": {"$ref": "#/$defs/param"},
        "label": {"$ref": "#/$defs/text"},
        "width": {"$ref": "#/$defs/extent"},
        "height": {"$ref": "#/$defs/extent"},
        "visible": {"type": "boolean"}
      },
      "$comment": "The bound parameter must declare a range within 0..1; the validator rejects it otherwise, because a binary control over a wider range would lie about its state."
    },

    "value": {
      "type": "object",
      "required": ["type", "param"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "value"},
        "param": {"$ref": "#/$defs/param"},
        "label": {"$ref": "#/$defs/text"},
        "precision": {"type": "integer", "minimum": 0, "maximum": 6},
        "width": {"$ref": "#/$defs/extent"},
        "height": {"$ref": "#/$defs/extent"},
        "visible": {"type": "boolean"}
      }
    },

    "label": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "label"},
        "text": {"$ref": "#/$defs/text"},
        "width": {"$ref": "#/$defs/extent"},
        "height": {"$ref": "#/$defs/extent"},
        "visible": {"type": "boolean"}
      }
    },

    "spacer": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "spacer"},
        "size": {"type": "integer", "minimum": 0, "maximum": 64},
        "width": {"$ref": "#/$defs/extent"},
        "height": {"$ref": "#/$defs/extent"},
        "visible": {"type": "boolean"}
      }
    }
  }
}
